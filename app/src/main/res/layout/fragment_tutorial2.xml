<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2B45"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_menu_message"
        android:contentDescription="Tutorial 2 Icon"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Responsif &amp; Interaktif"
        android:textColor="#BD3039"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Klik item pesan untuk melihat informasi detail pesan dan usia pengirim dengan notifikasi Snackbar interaktif."
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
