<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2B45"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:src="@drawable/red"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvUsername"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="User Profile"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saturnus Dimas Budi - Red Sox Edition"
        android:textColor="#8AB4F8"
        android:textSize="14sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnToFifthMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#163A5F"
        android:text="Ke Activity Fifth"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToSixthMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#163A5F"
        android:text="Ke Activity Sixth (Fragment)"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnLogoutMore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#BD3039"
        android:text="Logout"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
