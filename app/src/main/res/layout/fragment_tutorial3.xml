<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D2B45"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:src="@drawable/ic_menu_star"
        android:contentDescription="Tutorial 3 Icon"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nikmati Pengalaman Terbaik"
        android:textColor="#FFD700"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Geser (*swipe*) ke kiri dan kanan untuk menjelajahi halaman tutorial ini. Anda siap menggunakan fitur pesan!"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:gravity="center"
        android:lineSpacingExtra="4dp" />

</LinearLayout>
